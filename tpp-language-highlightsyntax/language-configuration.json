{
  "comments": {
    "blockComment": ["{", "}"]
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:se\\b.*\\bentão)|repita|senão|(?:inteiro|flutuante)\\s+[a-zA-ZáÁãÃàÀéÉíÍóÓõÕ][a-zA-Z0-9_áÁãÃàÀéÉíÍóÓõÕ]*\\s*\\([^)]*\\))\\s*$",
    "decreaseIndentPattern": "^\\s*(?:fim|senão|até\\b.*)\\s*$"
  },
  "wordPattern": "[a-zA-ZáÁãÃàÀéÉíÍóÓõÕ][a-zA-Z0-9_áÁãÃàÀéÉíÍóÓõÕ]*"
}
