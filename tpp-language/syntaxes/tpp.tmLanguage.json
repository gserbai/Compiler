{
  "name": "TPP",
  "scopeName": "source.tpp",
  "fileTypes": ["tpp"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#numbers" },
    { "include": "#functions" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.tpp",
          "match": "//.*$"
        },
        {
          "name": "comment.block.tpp",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.tpp" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.tpp" }
          }
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.tpp",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.tpp",
          "match": "\\\\."
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.tpp",
          "match": "\\b(se|então|entao|senão|senao)\\b"
        },
        {
          "name": "keyword.control.loop.tpp",
          "match": "\\b(repita|até|ate)\\b"
        },
        {
          "name": "keyword.control.return.tpp",
          "match": "\\bretorna\\b"
        },
        {
          "name": "keyword.control.end.tpp",
          "match": "\\bfim\\b"
        },
        {
          "name": "keyword.other.io.tpp",
          "match": "\\b(leia|escreva)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.tpp",
          "match": "\\b(inteiro|flutuante)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.tpp",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.comparison.tpp",
          "match": "(<=|>=|<>|<|>|=)"
        },
        {
          "name": "keyword.operator.assignment.tpp",
          "match": ":="
        },
        {
          "name": "punctuation.separator.tpp",
          "match": ":"
        },
        {
          "name": "keyword.operator.arithmetic.tpp",
          "match": "[+\\-*/]"
        },
        {
          "name": "punctuation.separator.comma.tpp",
          "match": ","
        },
        {
          "name": "punctuation.brackets.round.tpp",
          "match": "[()]"
        },
        {
          "name": "punctuation.brackets.square.tpp",
          "match": "[\\[\\]]"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.scientific.tpp",
          "match": "\\b\\d+\\.?\\d*e[+\\-]?\\d+\\b"
        },
        {
          "name": "constant.numeric.float.tpp",
          "match": "\\b\\d+\\.\\d*\\b"
        },
        {
          "name": "constant.numeric.integer.tpp",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.tpp",
          "match": "\\b([a-zA-Z_áéíóúãõâêôàèìòùÁÉÍÓÚÃÕÂÊÔÀÈÌÒÙ][a-zA-Z0-9_áéíóúãõâêôàèìòùÁÉÍÓÚÃÕÂÊÔÀÈÌÒÙ]*)\\s*(?=\\()"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.tpp",
          "match": "\\b[a-zA-Z_áéíóúãõâêôàèìòùÁÉÍÓÚÃÕÂÊÔÀÈÌÒÙ][a-zA-Z0-9_áéíóúãõâêôàèìòùÁÉÍÓÚÃÕÂÊÔÀÈÌÒÙ]*\\b"
        }
      ]
    }
  }
}
