digraph "CFG for 'main' function" {
	label="CFG for 'main' function";

	Node0x5950de227170 [shape=record,color="#b70d28ff", style=filled, fillcolor="#b70d2870" fontname="Courier",label="{entry:\l|  %retval = alloca i32, align 4\l  %b = alloca i32, align 4\l  store i32 10, ptr @a, align 4\l  %.3 = load i32, ptr @a, align 4\l  %.4 = icmp sge i32 %.3, 5\l  %.5 = load i32, ptr @a, align 4\l  %.6 = icmp sle i32 %.5, 20\l  %.7 = and i1 %.4, %.6\l  br i1 %.7, label %if.then, label %if.else\l|{<s0>T|<s1>F}}"];
	Node0x5950de227170:s0 -> Node0x5950de228120[tooltip="entry -> if.then\nProbability 50.00%" ];
