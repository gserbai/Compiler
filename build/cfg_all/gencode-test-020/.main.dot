digraph "CFG for 'main' function" {
	label="CFG for 'main' function";

	Node0x5d6d7eb4b2f0 [shape=record,color="#b70d28ff", style=filled, fillcolor="#b70d2870" fontname="Courier",label="{entry:\l|  %retval = alloca i32, align 4\l  %b = alloca i32, align 4\l  %.2 = getelementptr inbounds [3 x i8], ptr @fmt_scan_int_0, i32 0, i32 0\l  %.3 = call i32 (ptr, ...) @scanf(ptr %.2, ptr @a)\l  %.4 = load i32, ptr @a, align 4\l  %.5 = icmp sge i32 %.4, 5\l  %.6 = load i32, ptr @a, align 4\l  %.7 = icmp sle i32 %.6, 20\l  %.8 = and i1 %.5, %.7\l  br i1 %.8, label %if.then, label %if.else\l|{<s0>T|<s1>F}}"];
	Node0x5d6d7eb4b2f0:s0 -> Node0x5d6d7eb4ca70[tooltip="entry -> if.then\nProbability 50.00%" ];
	Node0x5d6d7eb4b2f0:s1 -> Node0x5d6d7eb4cae0[tooltip="entry -> if.else\nProbability 50.00%" ];
	Node0x5d6d7eb4ca70 [shape=record,color="#3d50c3ff", style=filled, fillcolor="#be242e70" fontname="Courier",label="{if.then:\l|  store i32 50, ptr %b, align 4\l  br label %if.end\l}"];
	Node0x5d6d7eb4ca70 -> Node0x5d6d7eb4ccd0[tooltip="if.then -> if.end\nProbability 100.00%" ];
	Node0x5d6d7eb4cae0 [shape=record,color="#3d50c3ff", style=filled, fillcolor="#be242e70" fontname="Courier",label="{if.else:\l|  store i32 100, ptr %b, align 4\l  br label %if.end\l}"];
	Node0x5d6d7eb4cae0 -> Node0x5d6d7eb4ccd0[tooltip="if.else -> if.end\nProbability 100.00%" ];
	Node0x5d6d7eb4ccd0 [shape=record,color="#b70d28ff", style=filled, fillcolor="#b70d2870" fontname="Courier",label="{if.end:\l|  %.14 = load i32, ptr %b, align 4\l  %.15 = getelementptr inbounds [4 x i8], ptr @fmt_print_int_1, i32 0, i32 0\l  %.16 = call i32 (ptr, ...) @printf(ptr %.15, i32 %.14)\l  store i32 0, ptr %retval, align 4\l  br label %exit\l}"];
	Node0x5d6d7eb4ccd0 -> Node0x5d6d7eb4d3f0[tooltip="if.end -> exit\nProbability 100.00%" ];
	Node0x5d6d7eb4d3f0 [shape=record,color="#b70d28ff", style=filled, fillcolor="#b70d2870" fontname="Courier",label="{exit:\l|  %ret.final = load i32, ptr %retval, align 4\l  ret i32 %ret.final\l}"];
}
