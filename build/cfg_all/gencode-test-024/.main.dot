digraph "CFG for 'main' function" {
	label="CFG for 'main' function";

	Node0x585bfc30deb0 [shape=record,color="#b70d28ff", style=filled, fillcolor="#b70d2870" fontname="Courier",label="{entry:\l|  %retval = alloca i32, align 4\l  %x = alloca i32, align 4\l  %.2 = call i32 @func(i32 1, i32 2)\l  store i32 %.2, ptr %x, align 4\l  %.4 = load i32, ptr %x, align 4\l  %.5 = getelementptr inbounds [4 x i8], ptr @fmt_print_int_0, i32 0, i32 0\l  %.6 = call i32 (ptr, ...) @printf(ptr %.5, i32 %.4)\l  store i32 0, ptr %retval, align 4\l  br label %exit\l}"];
	Node0x585bfc30deb0 -> Node0x585bfc30f770[tooltip="entry -> exit\nProbability 100.00%" ];
	Node0x585bfc30f770 [shape=record,color="#b70d28ff", style=filled, fillcolor="#b70d2870" fontname="Courier",label="{exit:\l|  %ret.final = load i32, ptr %retval, align 4\l  ret i32 %ret.final\l}"];
}
