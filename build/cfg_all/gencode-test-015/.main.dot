	Node0x56e830d2c2e0 [shape=record,color="#b70d28ff", style=filled, fillcolor="#b70d2870" fontname="Courier",label="{repeat.body:\l|  %.4 = getelementptr inbounds [3 x i8], ptr @fmt_scan_int_0, i32 0, i32 0\l  %.5 = call i32 (ptr, ...) @scanf(ptr %.4, ptr %a)\l  %.6 = getelementptr inbounds [3 x i8], ptr @fmt_scan_int_1, i32 0, i32 0\l  %.7 = call i32 (ptr, ...) @scanf(ptr %.6, ptr %b)\l  %.8 = load i32, ptr %a, align 4\l  %.9 = load i32, ptr %b, align 4\l  %.10 = call i32 @soma(i32 %.8, i32 %.9)\l  %.11 = load i32, ptr %a, align 4\l  %.12 = load i32, ptr %b, align 4\l  %.13 = call i32 @sub(i32 %.11, i32 %.12)\l  %.14 = call i32 @soma(i32 %.10, i32 %.13)\l  store i32 %.14, ptr %c, align 4\l  %.16 = load i32, ptr %c, align 4\l  %.17 = getelementptr inbounds [4 x i8], ptr @fmt_print_int_2, i32 0, i32 0\l  %.18 = call i32 (ptr, ...) @printf(ptr %.17, i32 %.16)\l  %.19 = load i32, ptr %i, align 4\l  %.20 = add i32 %.19, 1\l  store i32 %.20, ptr %i, align 4\l  %.22 = load i32, ptr %i, align 4\l  %.23 = icmp eq i32 %.22, 5\l  br i1 %.23, label %repeat.end, label %repeat.body\l|{<s0>T|<s1>F}}"];
	Node0x56e830d2c2e0:s0 -> Node0x56e830d2eff0[tooltip="repeat.body -> repeat.end\nProbability 3.12%" ];
	Node0x56e830d2c2e0:s1 -> Node0x56e830d2c2e0[tooltip="repeat.body -> repeat.body\nProbability 96.88%" ];
	Node0x56e830d2eff0 [shape=record,color="#3d50c3ff", style=filled, fillcolor="#d6524470" fontname="Courier",label="{repeat.end:\l|  store i32 0, ptr %retval, align 4\l  br label %exit\l}"];
	Node0x56e830d2eff0 -> Node0x56e830d2f220[tooltip="repeat.end -> exit\nProbability 100.00%" ];
	Node0x56e830d2f220 [shape=record,color="#3d50c3ff", style=filled, fillcolor="#d6524470" fontname="Courier",label="{exit:\l|  %ret.final = load i32, ptr %retval, align 4\l  ret i32 %ret.final\l}"];
