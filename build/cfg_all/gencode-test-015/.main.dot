digraph "CFG for 'main' function" {
	label="CFG for 'main' function";

	Node0x56e830d2b990 [shape=record,color="#3d50c3ff", style=filled, fillcolor="#d6524470" fontname="Courier",label="{entry:\l|  %retval = alloca i32, align 4\l  %a = alloca i32, align 4\l  %b = alloca i32, align 4\l  %c = alloca i32, align 4\l  %i = alloca i32, align 4\l  store i32 0, ptr %i, align 4\l  br label %repeat.body\l}"];
