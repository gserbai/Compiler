digraph "CFG for 'soma' function" {
	label="CFG for 'soma' function";

	Node0x56e830d2a460 [shape=record,color="#b70d28ff", style=filled, fillcolor="#b70d2870" fontname="Courier",label="{entry:\l|  %retval = alloca i32, align 4\l  %x.1 = alloca i32, align 4\l  store i32 %x, ptr %x.1, align 4\l  %y.1 = alloca i32, align 4\l  store i32 %y, ptr %y.1, align 4\l  %.6 = load i32, ptr %x.1, align 4\l  %.7 = load i32, ptr %y.1, align 4\l  %.8 = add i32 %.6, %.7\l  store i32 %.8, ptr %retval, align 4\l  br label %exit\l}"];
