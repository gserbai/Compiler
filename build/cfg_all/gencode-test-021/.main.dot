digraph "CFG for 'main' function" {
	label="CFG for 'main' function";

	Node0x558f24566120 [shape=record,color="#b70d28ff", style=filled, fillcolor="#b70d2870" fontname="Courier",label="{entry:\l|  %retval = alloca i32, align 4\l  %.2 = getelementptr inbounds [3 x i8], ptr @fmt_scan_int_0, i32 0, i32 0\l  %.3 = call i32 (ptr, ...) @scanf(ptr %.2, ptr @ano)\l  %.4 = load i32, ptr @ano, align 4\l  %.5 = call i32 @modulo(i32 %.4, i32 400)\l  %.6 = icmp eq i32 %.5, 0\l  %.7 = load i32, ptr @ano, align 4\l  %.8 = call i32 @modulo(i32 %.7, i32 4)\l  %.9 = icmp eq i32 %.8, 0\l  %.10 = or i1 %.6, %.9\l  %.11 = load i32, ptr @ano, align 4\l  %.12 = call i32 @modulo(i32 %.11, i32 100)\l  %.13 = icmp eq i32 %.12, 0\l  %.14 = xor i1 %.13, true\l  %.15 = and i1 %.10, %.14\l  br i1 %.15, label %if.then, label %if.end\l|{<s0>T|<s1>F}}"];
	Node0x558f24566120:s0 -> Node0x558f24567db0[tooltip="entry -> if.then\nProbability 50.00%" ];
