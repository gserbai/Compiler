	Node0x558f24567db0 [shape=record,color="#3d50c3ff", style=filled, fillcolor="#be242e70" fontname="Courier",label="{if.then:\l|  %.17 = load i32, ptr @ano, align 4\l  %.18 = getelementptr inbounds [4 x i8], ptr @fmt_print_int_1, i32 0, i32 0\l  %.19 = call i32 (ptr, ...) @printf(ptr %.18, i32 %.17)\l  %.20 = getelementptr inbounds [4 x i8], ptr @fmt_print_int_2, i32 0, i32 0\l  %.21 = call i32 (ptr, ...) @printf(ptr %.20, i32 1)\l  br label %if.end\l}"];
