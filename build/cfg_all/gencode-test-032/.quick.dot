digraph "CFG for 'quick' function" {
	label="CFG for 'quick' function";

	Node0x59d4b5d37aa0 [shape=record,color="#b70d28ff", style=filled, fillcolor="#b70d2870" fontname="Courier",label="{entry:\l|  %e.1 = alloca i32, align 4\l  store i32 %e, ptr %e.1, align 4\l  %d.1 = alloca i32, align 4\l  store i32 %d, ptr %d.1, align 4\l  %p = alloca i32, align 4\l  %.6 = load i32, ptr %e.1, align 4\l  %.7 = load i32, ptr %d.1, align 4\l  %.8 = icmp slt i32 %.6, %.7\l  br i1 %.8, label %if.then, label %if.end\l|{<s0>T|<s1>F}}"];
	Node0x59d4b5d37aa0:s0 -> Node0x59d4b5d38000[tooltip="entry -> if.then\nProbability 50.00%" ];
	Node0x59d4b5d37aa0:s1 -> Node0x59d4b5d38070[tooltip="entry -> if.end\nProbability 50.00%" ];
	Node0x59d4b5d38000 [shape=record,color="#3d50c3ff", style=filled, fillcolor="#be242e70" fontname="Courier",label="{if.then:\l|  %.10 = load i32, ptr %e.1, align 4\l  %.11 = load i32, ptr %d.1, align 4\l  %.12 = call i32 @partition(i32 %.10, i32 %.11)\l  store i32 %.12, ptr %p, align 4\l  %.14 = load i32, ptr %e.1, align 4\l  %.15 = load i32, ptr %p, align 4\l  %.16 = sub i32 %.15, 1\l  call void @quick(i32 %.14, i32 %.16)\l  %.18 = load i32, ptr %p, align 4\l  %.19 = add i32 %.18, 1\l  %.20 = load i32, ptr %d.1, align 4\l  call void @quick(i32 %.19, i32 %.20)\l  br label %if.end\l}"];
	Node0x59d4b5d38000 -> Node0x59d4b5d38070[tooltip="if.then -> if.end\nProbability 100.00%" ];
	Node0x59d4b5d38070 [shape=record,color="#b70d28ff", style=filled, fillcolor="#b70d2870" fontname="Courier",label="{if.end:\l|  br label %exit\l}"];
	Node0x59d4b5d38070 -> Node0x59d4b5d38cf0[tooltip="if.end -> exit\nProbability 100.00%" ];
	Node0x59d4b5d38cf0 [shape=record,color="#b70d28ff", style=filled, fillcolor="#b70d2870" fontname="Courier",label="{exit:\l|  ret void\l}"];
}
