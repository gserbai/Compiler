digraph "CFG for 'main' function" {
	label="CFG for 'main' function";

	Node0x629291908120 [shape=record,color="#b70d28ff", style=filled, fillcolor="#b70d2870" fontname="Courier",label="{entry:\l|  %retval = alloca i32, align 4\l  %ret = alloca i32, align 4\l  store i32 3, ptr @a, align 4\l  %.3 = load i32, ptr @a, align 4\l  %.4 = icmp sgt i32 %.3, 5\l  br i1 %.4, label %if.then, label %if.else\l|{<s0>T|<s1>F}}"];
