digraph "CFG for 'fibonacciRec' function" {
	label="CFG for 'fibonacciRec' function";

	Node0x59b3ec93a8d0 [shape=record,color="#b70d28ff", style=filled, fillcolor="#b70d2870" fontname="Courier",label="{entry:\l|  %retval = alloca i32, align 4\l  %n.1 = alloca i32, align 4\l  store i32 %n, ptr %n.1, align 4\l  %.4 = load i32, ptr %n.1, align 4\l  %.5 = icmp sle i32 %.4, 1\l  br i1 %.5, label %if.then, label %if.else\l|{<s0>T|<s1>F}}"];
	Node0x59b3ec93a8d0:s0 -> Node0x59b3ec93b000[tooltip="entry -> if.then\nProbability 50.00%" ];
	Node0x59b3ec93a8d0:s1 -> Node0x59b3ec93b070[tooltip="entry -> if.else\nProbability 50.00%" ];
	Node0x59b3ec93b000 [shape=record,color="#3d50c3ff", style=filled, fillcolor="#be242e70" fontname="Courier",label="{if.then:\l|  %.7 = load i32, ptr %n.1, align 4\l  store i32 %.7, ptr %retval, align 4\l  br label %exit\l}"];
	Node0x59b3ec93b000 -> Node0x59b3ec93b2d0[tooltip="if.then -> exit\nProbability 100.00%" ];
	Node0x59b3ec93b070 [shape=record,color="#3d50c3ff", style=filled, fillcolor="#be242e70" fontname="Courier",label="{if.else:\l|  %.10 = load i32, ptr %n.1, align 4\l  %.11 = sub i32 %.10, 1\l  %.12 = call i32 @fibonacciRec(i32 %.11)\l  %.13 = load i32, ptr %n.1, align 4\l  %.14 = sub i32 %.13, 2\l  %.15 = call i32 @fibonacciRec(i32 %.14)\l  %.16 = add i32 %.12, %.15\l  store i32 %.16, ptr %retval, align 4\l  br label %exit\l}"];
	Node0x59b3ec93b070 -> Node0x59b3ec93b2d0[tooltip="if.else -> exit\nProbability 100.00%" ];
	Node0x59b3ec93bff0 [shape=record,color="#3d50c3ff", style=filled, fillcolor="#3d50c370" fontname="Courier",label="{if.end:\l|  store i32 0, ptr %retval, align 4\l  br label %exit\l}"];
	Node0x59b3ec93bff0 -> Node0x59b3ec93b2d0[tooltip="if.end -> exit\nProbability 100.00%" ];
	Node0x59b3ec93b2d0 [shape=record,color="#b70d28ff", style=filled, fillcolor="#b70d2870" fontname="Courier",label="{exit:\l|  %ret.final = load i32, ptr %retval, align 4\l  ret i32 %ret.final\l}"];
}
